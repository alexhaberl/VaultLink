# This image is deliberately independent of application source and the image lock.
# Build and publish it for linux/amd64 and linux/arm64, then pin its manifest digest.
FROM rust:1.97.1-trixie@sha256:1bcff4befb740599103a2c7cb51058e14479b2e35e3a34a3f0dc4ede09927488

COPY deploy/docker/debian-snapshot.sources deploy/docker/debian-packages.lock /tmp/vaultlink-debian/
COPY tools/install-pinned-debian-packages.sh /tmp/vaultlink-debian/install.sh
RUN /bin/sh /tmp/vaultlink-debian/install.sh \
        /tmp/vaultlink-debian/debian-snapshot.sources \
        /tmp/vaultlink-debian/debian-packages.lock \
    && rm -rf /tmp/vaultlink-debian

RUN cargo install --locked cargo-cyclonedx --version 0.5.9 \
    && cargo install --locked cargo-audit --version 0.22.2

WORKDIR /work
