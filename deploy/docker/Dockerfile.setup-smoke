FROM rust:1.96.1-trixie@sha256:1f0dbad1df66647807e6952d1db85d0b2bda7606cb2139d82517e4f009967376

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        passwd \
        python3 \
        pkg-config \
        build-essential \
        shellcheck \
        sqlite3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /work
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY src ./src
COPY deploy/docker ./deploy/docker
COPY deploy/vaultlink-upgrade.sh deploy/vaultlink-rollback.sh ./deploy/

RUN test ! -e /work/config.toml \
    && test ! -e /work/.env \
    && ! find /work -type f -name '*.sqlite*' -print -quit | grep -q .

RUN cargo build --release --locked

CMD ["bash", "deploy/docker/setup-smoke.sh"]
