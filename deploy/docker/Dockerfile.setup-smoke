# Keep this pin aligned with rust-toolchain.toml and the release workflow.
FROM rust:1.97.0-trixie@sha256:8e117cab45b7e67c5d146456107cd0f8bf87df3a668e5cf142be6984cf900ca0

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        coreutils \
        curl \
        passwd \
        python3 \
        pkg-config \
        build-essential \
        shellcheck \
        sqlite3 \
        systemd \
        util-linux \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /work
COPY Cargo.toml Cargo.lock rust-toolchain.toml Makefile .dockerignore ./
COPY .github ./.github
COPY src ./src
COPY config ./config
COPY fuzz/Cargo.toml ./fuzz/Cargo.toml
COPY fuzz/fuzz_targets ./fuzz/fuzz_targets
COPY deploy ./deploy
COPY tools ./tools

RUN chmod 0644 deploy/Caddyfile deploy/*.conf deploy/*.example \
        deploy/vaultlink.service tools/*.txt \
    && chmod 0755 deploy/*.sh deploy/docker/*.sh tools/*.sh \
    && shellcheck deploy/*.sh deploy/docker/*.sh tools/*.sh \
    && sh tools/check-supply-chain-policy.sh

RUN test ! -e /work/config.toml \
    && test ! -e /work/.env \
    && ! find /work -type f -name '*.sqlite*' -print -quit | grep -q .

RUN install -d /opt/vaultlink /var/lib/vaultlink \
        /var/log/vaultlink /mnt/storage \
    && install -m 0755 /bin/true /opt/vaultlink/vaultlink \
    && systemd-analyze verify deploy/vaultlink.service \
    && rm -f /opt/vaultlink/vaultlink

RUN cargo build --release --locked

CMD ["bash", "deploy/docker/setup-smoke.sh"]
