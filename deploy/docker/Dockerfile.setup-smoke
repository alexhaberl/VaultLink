# Keep this pin aligned with rust-toolchain.toml and the release workflow.
FROM rust:1.97.0-trixie@sha256:44637ff22d0a6571a221bfaf137849711ad02ff4723dbb4736e297538f6a3e60

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        coreutils \
        curl \
        passwd \
        python3 \
        pkg-config \
        build-essential \
        shellcheck \
        sqlite3 \
        systemd \
        util-linux \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /work
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY src ./src
COPY fuzz/Cargo.toml ./fuzz/Cargo.toml
COPY fuzz/fuzz_targets ./fuzz/fuzz_targets
COPY deploy/docker ./deploy/docker
COPY --chmod=0755 deploy/vaultlink-upgrade.sh deploy/vaultlink-rollback.sh ./deploy/
COPY --chmod=0644 deploy/vaultlink.service ./deploy/

RUN test ! -e /work/config.toml \
    && test ! -e /work/.env \
    && ! find /work -type f -name '*.sqlite*' -print -quit | grep -q .

RUN install -d /opt/vaultlink /var/lib/vaultlink \
        /var/log/vaultlink /mnt/storage \
    && install -m 0755 /bin/true /opt/vaultlink/vaultlink \
    && systemd-analyze verify deploy/vaultlink.service \
    && rm -f /opt/vaultlink/vaultlink

RUN cargo build --release --locked

CMD ["bash", "deploy/docker/setup-smoke.sh"]
