# Keep this pin aligned with rust-toolchain.toml and the release workflow.
FROM rust:1.98.0-trixie@sha256:620dbcd124499c59e2406d3741574b5c5838cf9eb9656f0c3a03948f79b02959

COPY deploy/docker/debian-snapshot.sources deploy/docker/debian-packages.lock /tmp/vaultlink-debian/
COPY tools/install-pinned-debian-packages.sh /tmp/vaultlink-debian/install.sh
RUN /bin/sh /tmp/vaultlink-debian/install.sh \
        /tmp/vaultlink-debian/debian-snapshot.sources \
        /tmp/vaultlink-debian/debian-packages.lock \
    && rm -rf /tmp/vaultlink-debian

RUN cargo install --locked cargo-cyclonedx --version 0.5.9 \
    && cargo install --locked cargo-audit --version 0.22.2

WORKDIR /work
COPY Cargo.toml Cargo.lock rust-toolchain.toml Makefile .dockerignore .gitleaksignore ./
COPY .cargo ./.cargo
COPY README.md SECURITY.md CHANGELOG.md THREAT_MODEL.md LICENSE ./
COPY .github ./.github
COPY src ./src
COPY templates ./templates
COPY assets ./assets
COPY config ./config
COPY docs ./docs
COPY fuzz/Cargo.toml ./fuzz/Cargo.toml
COPY fuzz/fuzz_targets ./fuzz/fuzz_targets
COPY deploy ./deploy
COPY packaging ./packaging
COPY release ./release
COPY tools ./tools

RUN chmod 0644 deploy/Caddyfile deploy/*.conf deploy/*.example \
        deploy/*.service deploy/*.timer deploy/docker/*.lock \
        deploy/docker/*.sources tools/*.txt \
    && chmod 0755 deploy/*.sh deploy/docker/*.sh packaging/*.sh tools/*.sh \
    && groupadd --system vaultlink \
    && useradd --system --gid vaultlink --home-dir /nonexistent \
        --no-create-home --shell /usr/sbin/nologin vaultlink \
    && shellcheck deploy/*.sh deploy/docker/*.sh packaging/*.sh tools/*.sh \
    && sh tools/check-supply-chain-policy.sh

RUN test ! -e /work/config.toml \
    && test ! -e /work/.env \
    && ! find /work -type f -name '*.sqlite*' -print -quit | grep -q .

RUN install -d /opt/vaultlink /var/lib/vaultlink \
        /var/log/vaultlink /mnt/storage /usr/sbin \
        /usr/lib/vaultlink/package/deploy \
    && install -m 0755 /bin/true /opt/vaultlink/vaultlink \
    && install -m 0755 deploy/vaultlink-update.sh /usr/sbin/vaultlink-update \
    && install -m 0755 packaging/vaultlink-runtime-guard.sh \
        /usr/lib/vaultlink/package/deploy/vaultlink-runtime-guard.sh \
    && systemd-analyze verify deploy/vaultlink.service \
        deploy/vaultlink-update.service deploy/vaultlink-update.timer \
    && rm -f /opt/vaultlink/vaultlink /usr/sbin/vaultlink-update \
        /usr/lib/vaultlink/package/deploy/vaultlink-runtime-guard.sh

RUN cargo build --release --locked

EXPOSE 8081/tcp

USER vaultlink

CMD ["bash", "deploy/docker/setup-smoke.sh"]
