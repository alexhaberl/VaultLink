# syntax=docker/dockerfile:1.7
# Application source is deliberately excluded. BASE_IMAGE must be an immutable
# distro image selected by the protected image-refresh workflow.
ARG RUST_IMAGE=rust:1.98.0-trixie@sha256:271849e998ffce5776454bbf98c5dc21baafc854ff8e566197908d3aca9a81e8
ARG BASE_IMAGE
FROM ${RUST_IMAGE} AS rust

FROM ${BASE_IMAGE}

ARG BASE_IMAGE
ARG TARGET_ID
ARG DISTRIBUTION
ARG DISTRIBUTION_VERSION
ARG ARCH_SNAPSHOT_DATE=UNPROVISIONED
ARG TARGETARCH

COPY --from=rust /usr/local/cargo /usr/local/cargo
COPY --from=rust /usr/local/rustup /usr/local/rustup
COPY deploy/docker/install-package-builder-dependencies.sh /tmp/install-package-builder-dependencies.sh

ENV CARGO_HOME=/usr/local/cargo \
    RUSTUP_HOME=/usr/local/rustup \
    PATH=/usr/local/cargo/bin:${PATH} \
    SOURCE_DATE_EPOCH=0 \
    TZ=UTC \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

RUN /bin/sh /tmp/install-package-builder-dependencies.sh \
        "$TARGET_ID" "$DISTRIBUTION" "$DISTRIBUTION_VERSION" "$TARGETARCH" \
        "$ARCH_SNAPSHOT_DATE" "$BASE_IMAGE" \
    && cargo install --locked cargo-cyclonedx --version 0.5.9 \
    && cargo install --locked cargo-audit --version 0.22.2 \
    && test "$(rustc --version | awk '{print $2}')" = 1.98.0 \
    && rm -f /tmp/install-package-builder-dependencies.sh

WORKDIR /work
