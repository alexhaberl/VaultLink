[Unit]
Description=Check for a signed VaultLink native-package update
After=network-online.target local-fs.target vaultlink.service
Wants=network-online.target
ConditionFileIsExecutable=/usr/sbin/vaultlink-update
ConditionPathExists=/usr/share/vaultlink/install-method.env

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/sbin/vaultlink-update auto
TimeoutStartSec=90min
TimeoutStopSec=30min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateIPC=true
# Native package managers may execute distribution-owned sysusers/tmpfiles and
# transaction hooks whose complete write set is not VaultLink-controlled.
# Payload/metadata allowlists and signed-package verification are the write
# boundary for this root oneshot; a static ProtectSystem allowlist is unsafe.
ProtectSystem=false
ProtectHome=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictRealtime=true
RestrictNamespaces=true
RemoveIPC=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_FOWNER CAP_SETGID CAP_SETUID
# NoNewPrivileges prevents a normal exec chain from repopulating capabilities
# solely from the bounding set. Preserve exactly the bounded transaction set
# across package-manager/scriptlet execs; runuser drops permitted, effective,
# and ambient capabilities before executing the untrusted candidate as
# vaultlink, which the full-system gate verifies.
AmbientCapabilities=CAP_CHOWN CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_FOWNER CAP_SETGID CAP_SETUID
